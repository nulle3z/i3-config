#!/bin/bash

# 获取当前音量百分比和静音状态
VOLUME=$(pactl get-sink-volume @DEFAULT_SINK@ | grep -oP '\d+(?=%)' | head -n1)
MUTE=$(pactl get-sink-mute @DEFAULT_SINK@ | grep -oP '(?<=Mute: ).*')

# 输出到 bar
echo "$ICON $VOLUME%"
echo "$ICON $VOLUME%"

# 点击事件：左键打开 pavucontrol，滚轮调节音量
case $BLOCK_BUTTON in
    1) pavucontrol & ;;
    4) pactl set-sink-volume @DEFAULT_SINK@ +5% ;;
    5) pactl set-sink-volume @DEFAULT_SINK@ -5% ;;
    3) pactl set-sink-mute @DEFAULT_SINK@ toggle ;;
esac

