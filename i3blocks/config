# i3blocks profile

[WIRELESS]
command=~/.config/i3blocks/wireless
interval=5
label=WIRELESS: 


[ETHERNET]
command=~/.config/i3blocks/ethernet
interval=5
label=ETHERNET: 


[BATTERY]
command=~/.config/i3blocks/battery
interval=5
label=BAT: 


[DISK]
command=~/.config/i3blocks/disk
interval=30
label=DISK: 


[LOAD]
command=~/.config/i3blocks/load
interval=2
label=LOAD: 


[MEMORY]
command=~/.config/i3blocks/memory
interval=3
label=MEM: 


[TIME]
command=date '+%Y-%m-%d %a %H:%M'
interval=1
label=


[VOLUME]
command=~/.config/i3blocks/volume
interval=1
signal=1
